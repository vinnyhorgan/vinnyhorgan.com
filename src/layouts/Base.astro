---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Vinny Horgan';
const { title, description = 'I build AI tools for professionals, and emulators, consoles and editors for the love of it.' } = Astro.props;
const fullTitle = title ? `${title} | ${site}` : site;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vinny Horgan" />
    <meta name="theme-color" content="#f2f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111b16" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Vinny Horgan: writing" href="/rss.xml" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4">Skip to content</a>
    <header class="sheet pt-8 pb-14 sm:pt-10 sm:pb-20">
      <div class="full flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <a href="/" class="text-[1.05rem] font-[620] tracking-[-0.005em] text-(--ink) no-underline" aria-current={path === '/' ? 'page' : undefined}>
          Vinny Horgan
        </a>
        <nav aria-label="Main">
          <ul class="flex gap-6">
            {nav.map((item) => {
              const current = path === item.href || path.startsWith(item.href + '/');
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={current ? 'page' : undefined}
                    class:list={['no-underline hover:underline', current ? 'text-(--ink)' : 'text-(--quiet)']}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="sheet mt-28 pb-14 text-[0.9rem]">
      <hr class="full mb-8 border-(--rule)" />
      <p class="margin">Contact</p>
      <div>
        <p>
          Write to me at <a href="mailto:vinnyhorgan@gmail.com">vinnyhorgan@gmail.com</a>.
          My code is on <a href="https://github.com/vinnyhorgan">GitHub</a>.
        </p>
        <p class="quiet mt-6 italic">“What I cannot create, I do not understand.”<br />Richard Feynman</p>
      </div>
    </footer>
  </body>
</html>
