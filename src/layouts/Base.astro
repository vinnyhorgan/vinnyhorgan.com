---
import '../styles/global.css';
import Command from '../components/Command.astro';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Vinny Horgan';
const { title, description = 'I build AI tools for professionals, and emulators, consoles and editors for the love of it.' } = Astro.props;
const fullTitle = title ? `${title} | ${site}` : site;
// Built as files (work.html), served without the extension (/work).
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const notFound = path === '/404';
const nav = [
  { href: '/work', label: 'work' },
  { href: '/writing', label: 'writing' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vinny Horgan" />
    <meta name="theme-color" content="#eff1f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1e2e" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    {Astro.site && !notFound && <meta property="og:url" content={new URL(path, Astro.site)} />}
    {Astro.site && !notFound && <link rel="canonical" href={new URL(path, Astro.site)} />}
    {notFound && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Vinny Horgan: writing" href="/rss.xml" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4">Skip to content</a>
    <header class="page flex flex-wrap items-baseline justify-between gap-x-8 pt-8 pb-14 sm:pt-12 sm:pb-20">
      <a href="/" class="font-bold text-(--ink)" aria-current={path === '/' ? 'page' : undefined}>vinny horgan</a>
      <nav aria-label="Main">
        <ul class="flex gap-[2ch]">
          {nav.map((item) => {
            const current = path === item.href || path.startsWith(item.href + '/');
            return (
              <li>
                <a href={item.href} aria-current={current ? 'page' : undefined} class={current ? 'text-(--ink)' : 'text-(--quiet)'}>
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="page mt-16 pb-16">
      <Command>cat contact</Command>
      <p><a href="mailto:vinnyhorgan@gmail.com">vinnyhorgan@gmail.com</a></p>
      <p><a href="https://github.com/vinnyhorgan">github.com/vinnyhorgan</a></p>
      <p class="comment mt-6"># “What I cannot create, I do not understand.” Richard Feynman</p>
      <p class="mt-6"><span class="prompt" aria-hidden="true">~ $ </span><span class="cursor" aria-hidden="true"></span></p>
    </footer>
  </body>
</html>
