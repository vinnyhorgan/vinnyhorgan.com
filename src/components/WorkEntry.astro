---
import { Image } from 'astro:assets';
import type { Entry } from '../data/work';

interface Props {
  entry: Entry;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
---

<article id={entry.id} class="mt-10 scroll-mt-8 first:mt-0">
  <h3>{entry.title} <span class="quiet font-normal">{entry.when}</span></h3>
  <p>{entry.body}</p>
  {
    entry.image && (
      <Image
        src={entry.image.src}
        alt={entry.image.alt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 46rem) 44rem, calc(100vw - 2rem)"
        loading={eager ? 'eager' : 'lazy'}
        class="mt-4 w-full border border-(--rule)"
      />
    )
  }
  {
    entry.links && (
      <ul class="mt-2">
        {entry.links.map((link) => (
          <li>
            <span class="quiet" aria-hidden="true">-&gt; </span>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>
