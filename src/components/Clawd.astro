---
// Claude Code's little guy, pixel for pixel: a terminal draws him with
// half-block characters, so each pixel is twice as tall as it is wide.
// One outline rather than a square per pixel, so he stays clean when tilted.
---

<a href="https://claude.com/claude-code" class="clawd" title="Claude, who helped me build this site">
  <svg viewBox="1 0 16 10" width="32" height="20" role="img" aria-label="Claude Code’s mascot">
    <path
      fill="#d77757"
      d="M3 0h12v4h2v2h-2v2h-1v2h-1v-2h-1v2h-1v-2h-4v2h-1v-2h-1v2h-1v-2h-1v-2h-2v-2h2z"
    />
    <rect class="eye" x="5" y="2" width="1" height="2" />
    <rect class="eye" x="12" y="2" width="1" height="2" />
  </svg>
</a>

<style>
  /* A sticker on the side of the page, tilted: in the margin to the right of
     the column, or in the column's top corner when there is no margin. */
  .clawd {
    position: absolute;
    top: -0.4rem;
    right: 0;
    rotate: 12deg;
    line-height: 0;
  }

  @media (min-width: 62rem) {
    .clawd {
      top: -1rem;
      right: -7rem;
    }

    .clawd svg {
      width: 64px;
      height: 40px;
    }
  }

  .clawd svg {
    display: block;
  }

  .clawd:hover,
  .clawd:active {
    animation: hop 0.5s steps(2) 1;
  }

  .eye {
    fill: #000;
    animation: blink 4.5s steps(1) infinite;
  }

  @keyframes blink {
    96% {
      fill: #d77757;
    }
  }

  @keyframes hop {
    50% {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clawd,
    .eye {
      animation: none !important;
    }
  }
</style>
