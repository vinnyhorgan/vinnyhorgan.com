---
import { Image } from 'astro:assets';
import { stickers } from '../data/stickers';

// On phones the stickers make a row before the footer, at three quarters size.
---

<ul class="stickers" aria-label="Stickers">
  {
    stickers.map((s) => (
      <li
        class:list={['sticker', s.side]}
        style={`--top: ${s.top}; --x: ${s.x}; --tilt: ${s.tilt}; --width: ${s.width}px`}
      >
        <a
          href={s.href}
          title={s.label}
          class:list={[{ backed: s.backing, round: s.backing?.round, photo: s.photo }]}
          style={s.backing ? `--backing: ${s.backing.color}` : undefined}
        >
          {s.image && <Image src={s.image} alt={s.label} width={s.width * 2} />}
          {s.art && (
            <svg viewBox={`0 0 ${s.art.w} ${s.art.h}`} role="img" aria-label={s.label}>
              {s.art.paths.map((p) => (
                <path fill={p.fill} d={p.d} />
              ))}
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .stickers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.75rem;
    padding-top: 1rem;
  }

  /* Die-cut: a white edge that follows the shape, and a little shadow. */
  .sticker a {
    display: block;
    line-height: 0;
    rotate: var(--tilt);
    transition: rotate 0.2s ease-out;
    filter: drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff) drop-shadow(0 2px 0 #fff)
      drop-shadow(0 -2px 0 #fff) drop-shadow(0 2px 3px rgb(0 0 0 / 0.3));
  }

  .backed {
    background: var(--backing);
    padding: 7px 10px;
    border-radius: 6px;
  }

  .backed.round {
    padding: 6px;
    border-radius: 50%;
  }

  .photo.round img {
    border-radius: 50%;
  }

  /* Hovered, a sticker straightens as if you were about to peel it. */
  .sticker a:hover,
  .sticker a:focus-visible {
    rotate: 0deg;
  }

  .sticker :is(img, svg) {
    width: calc(var(--width) * 0.75);
    height: auto;
  }

  @media (min-width: 75rem) {
    .stickers {
      position: absolute;
      inset: 0;
      padding: 0;
      pointer-events: none;
      /* The side margin, from the column to the window's edge; on very wide
         windows only its inner 18rem, so the stickers stay near the text. */
      --margin: min((100vw - 46rem) / 2, 18rem);
    }

    .sticker {
      position: absolute;
      top: var(--top);
      pointer-events: auto;
    }

    .sticker.left {
      left: calc(-1 * var(--x) * var(--margin) - var(--width) / 2);
    }

    .sticker.right {
      right: calc(-1 * var(--x) * var(--margin) - var(--width) / 2);
    }

    .sticker :is(img, svg) {
      width: var(--width);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker a {
      transition: none;
    }
  }
</style>
