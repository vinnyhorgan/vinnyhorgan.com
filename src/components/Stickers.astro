---
import { stickers } from '../data/stickers';

// Pixels are 4px on wide screens, 3px in the row they make on phones.
---

<ul class="stickers" aria-label="Stickers">
  {
    stickers.map((s) => (
      <li class:list={['sticker', s.side]} style={`--top: ${s.top}; --tilt: ${s.tilt}; --offset: ${s.offset}`}>
        <a href={s.href} title={s.label} aria-label={s.label}>
          <svg viewBox={`0 0 ${s.w} ${s.h}`} style={`--w: ${s.w}; --h: ${s.h}`} aria-hidden="true">
            {s.paths.map((p) => (
              <path fill={p.fill} d={p.d} />
            ))}
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .stickers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    padding-top: 1rem;
  }

  .sticker a {
    display: block;
    line-height: 0;
    rotate: var(--tilt);
    transition: rotate 0.2s ease-out;
  }

  /* Hovered, a sticker straightens as if you were about to peel it. */
  .sticker a:hover,
  .sticker a:focus-visible {
    rotate: 0deg;
  }

  .sticker svg {
    width: calc(var(--w) * 3px);
    height: calc(var(--h) * 3px);
  }

  @media (min-width: 70rem) {
    .stickers {
      position: absolute;
      inset: 0;
      padding: 0;
      pointer-events: none;
    }

    .sticker {
      position: absolute;
      top: var(--top);
      pointer-events: auto;
    }

    .sticker.left {
      left: calc(-1 * var(--offset));
    }

    .sticker.right {
      right: calc(-1 * var(--offset));
    }

    .sticker svg {
      width: calc(var(--w) * 4px);
      height: calc(var(--h) * 4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker a {
      transition: none;
    }
  }
</style>
