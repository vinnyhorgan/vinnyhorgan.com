---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Command from '../components/Command.astro';
import { groups } from '../data/work';
import { formatDate } from '../lib/dates';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = groups.flatMap((group) => group.entries);
---

<Base>
  <div class="page space-y-10">
    <section aria-labelledby="whoami">
      <Command as="h1" id="whoami">whoami</Command>
      <p>
        Vinny Horgan, 22, from Monza. I’m the AI engineer at the Comune di
        Cinisello Balsamo, and on my own I build custom AI for professionals,
        like the assistant a law firm in Milan has used since September to
        draft its formal notices.
      </p>
      <p class="mt-4">
        For the love of it, I build emulators, consoles and editors, all the
        way down. As Feynman put it, what I cannot create, I do not
        understand.
      </p>
    </section>

    <section aria-labelledby="work">
      <Command id="work">ls work/</Command>
      <ul class="flex flex-wrap gap-x-[3ch]">
        {entries.map((entry) => (
          <li><a href={`/work#${entry.id}`}>{entry.id}/</a></li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="writing">
      <Command id="writing">ls writing/</Command>
      <ul>
        {posts.map((post) => (
          <li>
            <time class="quiet mr-[2ch]" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <a href={`/writing/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="now">
      <Command id="now">cat now.txt</Command>
      <p>
        Building AI agents at the Comune and for the law firm. Running Iris,
        my own server, which I now use for everything. And putting this site
        up on vinnyhorgan.com, a domain I’ve just bought back.
      </p>
      <p class="comment mt-4"># updated 2026-10</p>
    </section>
  </div>
</Base>
