---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Command from '../../components/Command.astro';
import { formatDate } from '../../lib/dates';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Writing" description="Posts by Vinny Horgan.">
  <div class="page">
    <Command as="h1">ls writing/</Command>
    <p class="comment">
      # The 2025 posts come from my first blog, “vinny’s brain”, moved here
      unchanged. Back then I made myself a rule: fix the form, never the
      content. If I change my mind, I write a new post.
    </p>

    <ul class="mt-8 space-y-4">
      {
        posts.map((post) => (
          <li>
            <time class="quiet mr-[2ch]" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <a href={`/writing/${post.id}`} class="font-bold">{post.data.title}</a>
            <p class="quiet">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
