// The site, as a Cloudflare Worker with static assets only: no code runs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinnyhorgan",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "vinnyhorgan.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
